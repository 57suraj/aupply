{
  "name": "aupply",
  "version": "1.0.0",
  "description": "Remote MCP server for the Aupply job application assistant. Provides Claude with authenticated access to candidate profile, resume, preferences, application history, and answer storage via five MCP tools.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev:server": "tsx watch src/server.ts",
    "dev:client": "vite",
    "dev:ext": "tsx watch src/extension/server/dev.ts",
    "dev": "concurrently -n server,ext,client -c cyan,yellow,magenta \"npm run dev:server\" \"npm run dev:ext\" \"npm run dev:client\"",
    "build": "npm run build:engines && npm run build:extension && tsc && vite build",
    "start": "NODE_ENV=production node dist/server.js",
    "typecheck": "tsc --noEmit",
    "e2e": "node scripts/e2e.mjs",
    "e2e:ext": "node scripts/e2e-ext.mjs",
    "ai:smoke": "tsx scripts/ai-smoke.mjs",
    "build:engines": "node scripts/build-engines.mjs",
    "build:extension": "node extension/scripts/build.mjs",
    "test:extension": "node --import tsx --test extension/test/*.test.ts"
  },
  "keywords": [
    "mcp",
    "claude",
    "job-application",
    "oauth",
    "supabase"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.15.1",
    "@supabase/supabase-js": "^2.50.3",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "framer-motion": "^13.4.4",
    "jose": "^6.2.12",
    "mammoth": "^1.13.0",
    "openai": "^7.27.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "stripe": "^22.6.2",
    "unpdf": "^1.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/express": "^5.0.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.15.34",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "jszip": "^3.10.2",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": "22.x"
  }
}
