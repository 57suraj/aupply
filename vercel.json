{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "regions": [
    "bom1"
  ],
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api"
    },
    {
      "source": "/health",
      "destination": "/api"
    },
    {
      "source": "/authorize",
      "destination": "/api"
    },
    {
      "source": "/token",
      "destination": "/api"
    },
    {
      "source": "/register",
      "destination": "/api"
    },
    {
      "source": "/revoke",
      "destination": "/api"
    },
    {
      "source": "/.well-known/:path*",
      "destination": "/api"
    },
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/ext/:path*",
      "destination": "/api/ext"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/ext.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/ext/v1/cron/cleanup",
      "schedule": "30 21 * * *"
    }
  ]
}
