# ──────────────────────────────────────────
# Supabase
# ──────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=    # SERVER-SIDE ONLY. Never expose to browser.
SUPABASE_ANON_KEY=            # Safe for browser. Used by frontend.

# Frontend-exposed Supabase vars (VITE_ prefix required by Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ──────────────────────────────────────────
# OAuth 2.1 (Claude connector)
# ──────────────────────────────────────────
# Clients (e.g. Claude) register themselves via /register; no client id/secret
# is configured here. This secret signs access tokens and authorization requests.
JWT_SECRET=                   # SERVER-SIDE ONLY. 32+ random characters.

# Local only: with NODE_ENV=development, "Authorization: Bearer dev-token" on /mcp
# acts as this Supabase user id. Never set in production.
DEV_USER_ID=

# ──────────────────────────────────────────
# MCP / Server
# ──────────────────────────────────────────
MCP_BASE_URL=                 # Public base URL, e.g. https://aupply.app
VITE_MCP_BASE_URL=            # Same value — exposed to browser for MCP URL display

PORT=3000
NODE_ENV=development

# scripts/e2e.mjs target (default http://localhost:3100)
E2E_BASE_URL=

# ──────────────────────────────────────────
# Stripe
# ──────────────────────────────────────────
# Found in: Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=            # SERVER-SIDE ONLY. sk_live_... or sk_test_...
STRIPE_WEBHOOK_SECRET=        # SERVER-SIDE ONLY. whsec_... (from Stripe webhook config)
STRIPE_PRICE_ID=              # Price ID for $2/month recurring price (price_...)

# ──────────────────────────────────────────
# Chrome extension channel (/ext/v1, src/extension; docs/extension/BUILD-INSTRUCTIONS.md)
# ──────────────────────────────────────────
EXT_JWT_SECRET=               # SERVER-SIDE ONLY. Signs device access tokens; never JWT_SECRET. openssl rand -base64 48
CRON_SECRET=                  # SERVER-SIDE ONLY. Vercel cron sends it to /ext/v1/cron/cleanup. openssl rand -base64 32
DEEPSEEK_API_KEY=             # SERVER-SIDE ONLY. The user's DeepSeek key (job scoring, hard form questions, onboarding).
AI_BASE_URL=https://api.deepseek.com   # OpenAI-compatible endpoint
AI_FAST_MODEL=deepseek-flash  # thinking off: scoring and extraction
AI_SMART_MODEL=deepseek-flash # thinking on: form answers and onboarding (switch to V4.1-Pro when it launches)
AI_PRICES_JSON=               # optional: overrides the price table, {"model":{"hit":0.006,"miss":0.30,"out":1.20}} per 1M tokens
EXT_AI_DAILY_BUDGET_MICRO_USD=100000   # AI budget per user per day ($0.10)
EXT_MIN_VERSION=0.1.0         # raise to force every extension to update
EXT_LINKEDIN_ENABLED=true     # kill switch: false stops every extension's LinkedIn work
AI_FAKE=                      # 1 only for e2e: deterministic AI stub, no network
AI_SMART_JSON_MODE=           # off: the smart tier sends no response_format (only if npm run ai:smoke says JSON mode fails with thinking on)
EXT_PORT=3001                 # local extension API (npm run dev:ext)
E2E_EXT_BASE_URL=             # scripts/e2e-ext.mjs target (default http://localhost:3101)
